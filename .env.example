# Copy this file to .env and fill in your values:  cp .env.example .env

# --- ClickUp ----------------------------------------------------------
# Personal API token: ClickUp -> avatar -> Settings -> Apps -> API Token
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxx
# Workspace (team) id — the number after app.clickup.com/ in your browser URL
CLICKUP_TEAM_ID=90120001234
# Optional: numeric ClickUp user id to report on.
# Leave empty to auto-detect the owner of the API token.
CLICKUP_USER_ID=

# --- GitHub -----------------------------------------------------------
# Classic token with `repo` scope, or fine-grained token with read-only
# "Contents" permission on the repository below.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
# The repository your branches live in, as owner/repo
GITHUB_REPO=your-org/your-repo
# Branch that feature branches are compared against
GITHUB_BASE_BRANCH=development

# --- Ollama (local LLM) -------------------------------------------------
# Any locally pulled model works: deepseek-coder, llama3, qwen2.5-coder, ...
OLLAMA_MODEL=deepseek-coder
# IMPORTANT for cron: use the full binary path (find it with:  which ollama)
OLLAMA_BIN=/usr/local/bin/ollama
OLLAMA_TIMEOUT_SECONDS=300

# --- Behaviour ----------------------------------------------------------
# true = run everything but do NOT post comments to ClickUp (safe test mode)
DRY_RUN=false
LOG_LEVEL=INFO
# Character budget for the diff embedded in the LLM prompt
MAX_DIFF_CHARS=12000
MAX_DIFF_CHARS_PER_FILE=4000
